# Development only: PostgreSQL Compose binds to loopback with trust authentication.
RELAY_DATABASE_URL=postgresql://relay@127.0.0.1:55432/relay
RELAY_HTTP_TIMEOUT_S=2
RELAY_LEASE_S=30
RELAY_CONCURRENCY=8
RELAY_BATCH=16
RELAY_POLL_MS=50
RELAY_RETRY_BASE_S=10
RELAY_RETRY_CAP_S=3600
RELAY_MAX_ATTEMPTS=15
# Set a strong value to require a Bearer token on management endpoints.
RELAY_ADMIN_TOKEN=
